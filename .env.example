# Backend
MEDSTOCK_DB_URL=jdbc:postgresql://localhost:5432/medstock
MEDSTOCK_DB_USERNAME=postgres
MEDSTOCK_DB_PASSWORD=postgres
MEDSTOCK_DB_SCHEMA=medstock
MEDSTOCK_ADMIN_SEED_PASSWORD=$2a$10$replace.with.bcrypt.hash
MEDSTOCK_JWT_ISSUER=medstock
MEDSTOCK_JWT_ACCESS_TOKEN_MINUTES=15
MEDSTOCK_JWT_REFRESH_TOKEN_DAYS=7
MEDSTOCK_JWT_PRIVATE_KEY=
MEDSTOCK_JWT_PUBLIC_KEY=
MEDSTOCK_GOOGLE_CLIENT_ID=
MEDSTOCK_GOOGLE_CLIENT_SECRET=
MEDSTOCK_GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
MEDSTOCK_OAUTH2_SUCCESS_REDIRECT=http://localhost:5173/login
MEDSTOCK_CORS_ALLOWED_ORIGINS=http://localhost:5173
MEDSTOCK_MAIL_HOST=smtp.gmail.com
MEDSTOCK_MAIL_PORT=587
MEDSTOCK_MAIL_USERNAME=
MEDSTOCK_MAIL_PASSWORD=
MEDSTOCK_TWILIO_ACCOUNT_SID=
MEDSTOCK_TWILIO_AUTH_TOKEN=
MEDSTOCK_TWILIO_FROM_PHONE=
MEDSTOCK_TWILIO_FROM_WHATSAPP=
MEDSTOCK_ALERT_DEDUP_HOURS=24
MEDSTOCK_SERVER_PORT=8080

# AI Provider Selection (env-driven)
# Set only one API key for automatic provider selection, or force one using MEDSTOCK_AI_PROVIDER.
MEDSTOCK_AI_PROVIDER=
MEDSTOCK_GEMINI_API_KEY=
MEDSTOCK_GEMINI_MODEL=gemini-2.5-flash
MEDSTOCK_OPENAI_API_KEY=
MEDSTOCK_CLAUDE_API_KEY=
MEDSTOCK_OLLAMA_BASE_URL=http://localhost:11434

# AWS
MEDSTOCK_AWS_REGION=ap-south-1
MEDSTOCK_AWS_S3_BUCKET=medstock-photos
MEDSTOCK_AWS_ACCESS_KEY_ID=
MEDSTOCK_AWS_SECRET_ACCESS_KEY=

# Frontend
VITE_MEDSTOCK_API_BASE_URL=http://localhost:8080
